    { "id": "default", "construct": "flow.default(a, b)", "lowering": "expression function default (null, undefined and \"\" replaced)" },
    { "id": "call-fallback", "construct": "flow.while({…}) | flow.forEach({…}) | flow.if({…}) | flow.try({…})", "block": "while | forEach | if | try", "where": "properties beyond the JavaScript form; slots keep $$ keys" },
