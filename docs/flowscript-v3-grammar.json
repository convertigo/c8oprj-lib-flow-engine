    { "id": "declare", "construct": "const x = e | let x = e | let x", "block": "set", "lowering": "local.x = e (undefined without value)" },
    { "id": "declare-destructuring", "construct": "const { a, b: c } = o", "block": "set", "lowering": "local.a = o.a; local.c = o.b", "limits": "one level, no default, no rest" },
    { "id": "assign-local", "construct": "x = e | local.x = e | local.o.k = e", "block": "set" },
    { "id": "assign-compound", "construct": "x += e | x -= e | x *= e | x /= e | x++ | x--", "block": "set", "lowering": "local.x = local.x + (e)", "where": "statement only" },
    { "id": "result-field", "construct": "result.x = e", "block": "set" },
    { "id": "return-object", "construct": "return { a, b: e }", "block": "set + return", "lowering": "result.a = local.a; result.b = e; return" },
    { "id": "return", "construct": "return | return e", "block": "return" },
    { "id": "if", "construct": "if (c) {…} else if (d) {…} else {…}", "block": "if" },
