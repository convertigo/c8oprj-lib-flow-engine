    { "id": "for-of", "construct": "for (const item of items) {…}", "block": "forEach", "lowering": "item read as current in its own body; one level of object destructuring" },
    { "id": "for-counted", "construct": "for (let i = a; i < b; i++) {…}", "block": "set + while", "limits": "< or <=, step ++, no continue in body" },
    { "id": "switch", "construct": "switch (x) { case LITERAL: …; break; default: … }", "block": "if chain", "limits": "literal labels, every case ends with break/return/throw, default last" },
