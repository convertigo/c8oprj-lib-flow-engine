    { "id": "chain", "construct": "xs.filter(…).map(…).join(\", \")", "lowering": "one node per block step, linked by local.__chain<N>", "where": "assignment or return; not in a branch of ?: && || ??, not in an expression function argument, not after a scope read of the statement" },
