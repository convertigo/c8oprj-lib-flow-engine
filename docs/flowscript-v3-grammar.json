    { "id": "list-find", "construct": "xs.find(x => c)", "block": "list.find", "properties": { "items": "xs", "where": "c" }, "note": "new block" },
    { "id": "list-some", "construct": "xs.some(x => c)", "block": "list.some", "properties": { "items": "xs", "where": "c" }, "note": "new block" },
