[
  { "block": "text.trim", "input": { "text": "  Flow  " }, "expected": "Flow" },
  { "block": "text.lines", "input": { "text": " a\r\n\r\n b ", "trim": true, "skipEmpty": true }, "expected": ["a", "b"] },
  { "block": "list.take", "input": { "items": [0, 1, 2, 3], "offset": 1, "count": 2 }, "expected": [1, 2] },
  { "block": "list.compact", "input": { "items": [null, "", "a", ["b", null]], "flatten": true, "skipEmptyString": true }, "expected": ["a", "b"] },
  { "block": "list.pluck", "input": { "items": [{ "meta": { "name": "a" } }, {}, { "meta": { "name": "b" } }], "path": "meta.name", "skipMissing": true }, "expected": ["a", "b"] },
  { "block": "list.search", "input": { "items": [{ "name": "Alpha" }, { "name": "Beta" }, "alphabet"], "query": "alpha", "limit": 2 }, "expected": [{ "name": "Alpha" }, "alphabet"] },
  { "block": "object.get", "input": { "source": { "a": { "b": 3 } }, "key": "a.b", "defaultValue": 0 }, "expected": 3 },
  { "block": "object.keys", "input": { "source": { "a": 1, "b": 2 } }, "expected": ["a", "b"] },
  { "block": "object.values", "input": { "source": { "a": 1, "b": 2 } }, "expected": [1, 2] },
  { "block": "object.firstEntry", "input": { "source": { "a": 1, "b": 2 } }, "expected": { "key": "a", "value": 1 } },
  { "block": "object.merge", "input": { "target": { "a": 1, "b": 1 }, "source": { "b": 2, "c": 3 } }, "expected": { "a": 1, "b": 2, "c": 3 } },
  { "block": "object.pick", "input": { "source": { "a": 1, "nested": { "b": 2 } }, "keys": ["a", "nested.b"] }, "expected": { "a": 1, "b": 2 } },
  { "block": "json.parse", "input": { "text": "{\"a\":1}" }, "expected": { "a": 1 } },
  { "block": "json.safeParse", "input": { "text": "[1,2]" }, "expected": { "ok": true, "value": [1, 2], "error": "" } },
  { "block": "json.stringify", "input": { "value": { "a": 1 }, "pretty": false }, "expected": "{\"a\":1}" },
  { "block": "json.select", "input": { "source": { "rows": [{ "name": "first" }] }, "path": "rows[0].name" }, "expected": "first" },
  { "block": "json.items", "input": { "source": { "items": [1, null, 2] }, "path": "items", "includeScalar": true }, "expected": [1, 2] },
  { "block": "value.toText", "input": { "value": 42 }, "expected": "42" },
  { "block": "value.toNumber", "input": { "value": "12.5", "fallback": 0 }, "expected": 12.5 },
  { "block": "value.toBoolean", "input": { "value": "yes" }, "expected": true },
  { "block": "compare.equal", "input": { "left": "1", "right": 1 }, "expected": false },
  { "block": "compare.notEqual", "input": { "left": "1", "right": 1 }, "expected": true },
  { "block": "compare.greater", "input": { "left": 3, "right": 2 }, "expected": true },
  { "block": "compare.less", "input": { "left": "a", "right": "b" }, "expected": true },
  { "block": "list.first", "input": { "items": ["a", "b"] }, "expected": "a" },
  { "block": "list.last", "input": { "items": ["a", "b"] }, "expected": "b" },
  { "block": "list.count", "input": { "items": ["a", "b"] }, "expected": 2 },
  { "block": "duration.format", "input": { "milliseconds": 75432, "showHours": false, "fractionDigits": 1 }, "expected": "01:15.4" },
  { "block": "number.add", "input": { "left": 12.5, "right": 7.5 }, "expected": 20 },
  { "block": "number.subtract", "input": { "left": 20, "right": 7.5 }, "expected": 12.5 },
  { "block": "number.choose", "input": { "condition": true, "whenTrue": 12, "whenFalse": 4 }, "expected": 12 }
]
